---
source: tests/repo_hardening.rs
expression: "canonical(\".github/rulesets/release-tags.json\")"
---
{
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/tags/v*"
      ]
    }
  },
  "enforcement": "active",
  "name": "Protect release tags",
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    }
  ],
  "target": "tag"
}
