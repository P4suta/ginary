{application, notify, [
    {vsn, "0.1.0"},
    {applications, [argus,
                    beecrypt,
                    gleam_crypto,
                    gleam_erlang,
                    gleam_http,
                    gleam_json,
                    gleam_otp,
                    gleam_stdlib,
                    http3,
                    mist,
                    notify_core,
                    postgleam,
                    sqlight]},
    {description, "A self-hosted ntfy-compatible notification server written in Gleam"},
    {modules, [notify,
               notify@@main,
               notify@access,
               notify@attachment_migration,
               notify@attachment_store,
               notify@attachment_store@filesystem,
               notify@attachment_store@memory,
               notify@attachment_store@postgres,
               notify@attachment_store@s3,
               notify@audit,
               notify@audit@memory,
               notify@audit@postgres,
               notify@audit@sqlite,
               notify@backup,
               notify@broker,
               notify@cli,
               notify@cluster@health,
               notify@cluster@postgres_bus,
               notify@config,
               notify@delivery,
               notify@delivery@memory,
               notify@delivery@postgres,
               notify@delivery@relay,
               notify@delivery@sqlite,
               notify@delivery@worker,
               notify@dispatch_pool,
               notify@doctor,
               notify@health_snapshot,
               notify@http3_listener,
               notify@http@admin,
               notify@http@attachment_upload,
               notify@http@audit_log,
               notify@http@auth,
               notify@http@compat_account,
               notify@http@cursor,
               notify@http@filter_params,
               notify@http@h3,
               notify@http@live,
               notify@http@parameter,
               notify@http@rate_enforcer,
               notify@http@rate_policy,
               notify@http@router,
               notify@http@subscription,
               notify@http@transport,
               notify@identity,
               notify@identity@postgres,
               notify@identity@sqlite,
               notify@log,
               notify@migration@ntfy,
               notify@network,
               notify@proxy,
               notify@rate_limit,
               notify@runtime,
               notify@scheduler,
               notify@security@password,
               notify@security@token,
               notify@server,
               notify@service,
               notify@since,
               notify@sqlite_lock,
               notify@storage,
               notify@storage@memory,
               notify@storage@postgres,
               notify@storage@sqlite,
               notify@template,
               notify@webpush,
               notify@webpush@crypto,
               notify@webpush@memory,
               notify@webpush@postgres,
               notify@webpush@provider,
               notify@webpush@sqlite,
               notify_attachment_stream_ffi,
               notify_ffi,
               notify_http3_test_ffi,
               notify_template_ffi]},
    {registered, []}
]}.
