/target/
/tools/mutation-plan/target/
/.cache/
/build/
# `mise run mutants` writes its working copy, its logs and its outcome
# lists into the project root. `fuzz/.gitignore` already covers the
# equivalent for the fuzz targets.
/mutants.out/
/mutants.out.old/
# The repack pipeline writes 40 MB tarballs and one small catalog into dist/otp.
# The catalog is the reproducible record of what the pipeline produced and is
# committed; the tarballs it names, and everything else under dist/, are not.
/dist/*
!/dist/otp/
/dist/otp/*
!/dist/otp/catalog.json
erl_crash.dump
tests/fixtures/*/build/
*.log
*.snap.new
*.profraw
__pycache__/
